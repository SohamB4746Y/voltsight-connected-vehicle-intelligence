<!-- Per-query limits: a runaway query fails (or spills to disk) on its own instead of pushing the server over its
     total memory limit, which would also fail the sink's inserts. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>1073741824</max_memory_usage>
            <max_bytes_before_external_group_by>268435456</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>268435456</max_bytes_before_external_sort>
            <max_threads>4</max_threads>
            <use_uncompressed_cache>0</use_uncompressed_cache>
        </default>
    </profiles>
</clickhouse>
