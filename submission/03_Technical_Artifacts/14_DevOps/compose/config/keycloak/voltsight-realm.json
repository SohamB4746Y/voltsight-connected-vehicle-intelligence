{
  "accessTokenLifespan": 300,
  "attributes": {
    "unmanagedAttributePolicy": "ADMIN_EDIT"
  },
  "bruteForceProtected": true,
  "clients": [
    {
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "clientId": "voltsight-web",
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "implicitFlowEnabled": false,
      "name": "VoltSight web",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "id.token.claim": "true",
            "jsonType.label": "String",
            "user.attribute": "tenant_id"
          },
          "consentRequired": false,
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "roles",
            "id.token.claim": "false",
            "jsonType.label": "String",
            "multivalued": "true"
          },
          "consentRequired": false,
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "voltsight-api"
          },
          "consentRequired": false,
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        }
      ],
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8081/*"
      ],
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8081"
      ]
    },
    {
      "bearerOnly": true,
      "clientId": "voltsight-api",
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "name": "VoltSight API (resource server)",
      "protocol": "openid-connect",
      "standardFlowEnabled": false
    },
    {
      "clientId": "voltsight-test",
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "directAccessGrantsEnabled": true,
      "enabled": true,
      "implicitFlowEnabled": false,
      "name": "VoltSight test client (DEV ONLY)",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "id.token.claim": "true",
            "jsonType.label": "String",
            "user.attribute": "tenant_id"
          },
          "consentRequired": false,
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "roles",
            "id.token.claim": "false",
            "jsonType.label": "String",
            "multivalued": "true"
          },
          "consentRequired": false,
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "voltsight-api"
          },
          "consentRequired": false,
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "account"
          },
          "consentRequired": false,
          "name": "account-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        }
      ],
      "publicClient": false,
      "secret": "${KC_TEST_CLIENT_SECRET}",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false
    }
  ],
  "defaultSignatureAlgorithm": "RS256",
  "displayName": "VoltSight",
  "enabled": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
